rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if a user is an admin by looking up their role in Firestore.
    function isAdmin() {
      return request.auth != null && 
             get(/databases/(default)/documents/participants/$(request.auth.uid)).data.role == 'Admin';
    }
    
    // Rules for files within the 'events' directory
    match /events/{eventId}/{allPaths=**} {
      
      // Allow anyone with the URL to read (view/download) the file.
      // This is necessary for the download links to work for all users.
      allow read: if true;

      // Allow write operations (create, update, delete) only if the user is an admin.
      allow write: if isAdmin();
    }
  }
}
