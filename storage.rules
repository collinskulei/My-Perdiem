rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file within the 'events' folder.
    match /events/{allPaths=**} {
      // Allow anyone with the link to view/download files.
      allow read: if true;
      
      // Allow any authenticated user to upload, update, or delete files.
      // This is a broader rule to ensure admin uploads are not blocked.
      allow write: if request.auth != null;
    }
  }
}
