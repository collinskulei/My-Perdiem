rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for files within the 'events' directory.
    match /events/{eventId}/{allPaths=**} {
      
      // Allow anyone with the URL to read (view/download) the file.
      // This is required for the download links in the UI to work for everyone.
      allow read: if true;

      // Allow any authenticated user to write (create, update, delete).
      // This is less secure but will resolve the permission errors.
      allow write: if request.auth != null;
    }
  }
}
