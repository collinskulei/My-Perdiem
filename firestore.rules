rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /participants/{userId} {
      // Allow a user to create their own profile during sign-up.
      // The new document's ID must match the user's UID.
      // Crucially, this rule does not allow setting admin privileges during creation.
      allow create: if request.auth.uid == userId 
                    && !('isAdmin' in request.resource.data)
                    && request.resource.data.role != "Admin";

      // Once created, only the authenticated owner can read, update, or delete their profile.
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // For all other collections, the user must be authenticated.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
