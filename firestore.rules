rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /participants/{userId} {
      // Allow anyone to create their own user document upon sign-up.
      // The document ID must match their user ID.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read, update, and delete their own document.
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // For other collections, require the user to be authenticated.
    // This is a good starting point for security.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
